# Variables de entorno del backend — O.IR
# Copiar este archivo como .env y rellenar los valores reales

# --- Redis (cola de tareas Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Base de datos (Supabase) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/oir
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# --- Google Gemini AI (Transcripción universal de letras desde audio) ---
GEMINI_API_KEY=your_gemini_api_key_from_aistudio

# --- Límites del sistema ---
MAX_AUDIO_DURATION=300   # Duración máxima de audio en segundos (5 minutos)

# --- Entorno de ejecución ---
ENVIRONMENT=development  # development | production

# --- CORS: orígenes permitidos (separados por coma) ---
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
