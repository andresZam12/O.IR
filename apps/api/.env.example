# Variables de entorno del backend — O.IR
# Copiar este archivo como .env y rellenar los valores reales

# --- Redis (cola de tareas Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Base de datos (Supabase) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/oir
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# --- Google Gemini AI (Transcripción universal de letras desde audio) ---
GEMINI_API_KEY=your_gemini_api_key_from_aistudio

# --- Límites del sistema ---
MAX_AUDIO_DURATION=300   # Duración máxima de audio en segundos (5 minutos)

# --- YouTube Anti-Bot Bypass (Render / Cloud Datacenter) ---
# Proxy residencial para eludir bloqueos antibot de YouTube en la nube (Render, AWS, Heroku)
# Obtén uno gratuito en https://www.webshare.io o proveedores similares
# Formato: http://username:password@proxy.webshare.io:80
YOUTUBE_PROXY=

# Proof of Origin Token (PoToken) opcional para yt-dlp
YOUTUBE_POTOKEN=

# Contenido de cookies de YouTube en formato Netscape (opcional)
YOUTUBE_COOKIES=

