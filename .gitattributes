# Normalizar los saltos de línea: el repo guarda LF, Windows puede usar CRLF localmente
* text=auto

# Archivos que siempre deben tener LF (scripts Python, shell)
*.py text eol=lf
*.sh text eol=lf

# Archivos que siempre deben tener LF (web)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Archivos binarios — no tocar saltos de línea
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
